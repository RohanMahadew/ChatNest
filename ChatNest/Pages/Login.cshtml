@page
@model ChatNest.Pages.LoginModel

@{
    ViewData["Title"] = "Login";
}

<partial name="Components/AuthHero" />

<register-form method="post"
               heading="Welcome back"
               title="Sign in to your account"
               description="Enter your details to continue."
               submit-text="Sign in"
               has-account="false">

<partial name="Components/ErrorDisplay" />

<partial name="Components/AuthInput"
         view-data='new ViewDataDictionary(ViewData)
         {
             ["Id"] = "Username",
             ["Label"] = "Username",
             ["Type"] = "text",
             ["Autocomplete"] = "username",
             ["Placeholder"] = "enter-your-username",
             ["Required"] = true
         }' />

<partial name="Components/AuthInput"
         view-data='new ViewDataDictionary(ViewData)
         {
             ["Id"] = "Password",
             ["Label"] = "Password",
             ["Type"] = "password",
             ["Autocomplete"] = "new-password",
             ["Placeholder"] = "••••••••••••",
             ["Required"] = true
         }' />

</register-form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

