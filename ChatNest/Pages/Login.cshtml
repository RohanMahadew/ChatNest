@page
@model ChatNest.Pages.LoginModel

@{
    ViewData["Title"] = "Login";
}

<partial name="Components/AuthHero" />

<register-form method="post"
               heading="Welcome back"
               title="Sign in to your account"
               description="Enter your details to continue."
               submit-text="Sign in"
               has-account="false">

    <auth-input asp-for="Input.Username" />
    <auth-input asp-for="Input.Password" />

</register-form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

