@{
    var id = ViewData["Id"]?.ToString() ?? "";
    var label = ViewData["Label"]?.ToString() ?? "";
    var type = ViewData["Type"]?.ToString() ?? "text";
    var autocomplete = ViewData["Autocomplete"]?.ToString();
    var placeholder = ViewData["Placeholder"]?.ToString();
    var required = ViewData["Required"] as bool? ?? false;

    var fieldName = $"Input.{id}";
    var fieldId = fieldName.Replace(".", "_");
}

<div>
    <label for="@id"
           class="mb-2 block text-sm font-semibold text-white/80">
        @label
    </label>

    <input type="@type"
           id="@id"
           name="Input.@id"
           autocomplete="@autocomplete"
           placeholder="@placeholder"
           required="@required"
           class="h-11 w-full rounded-lg border border-white/10
    bg-white/[0.07] px-3.5 text-sm text-white
    placeholder:text-white/25 outline-none
    transition duration-200
    focus:border-[#a875bc] focus:bg-white/[0.09]
    focus:ring-2 focus:ring-[#603273]/40" />

    @Html.ValidationMessage(
        fieldName,
        null,
        new { @class = "text-danger" })
</div>