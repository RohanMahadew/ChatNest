@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<partial name="Components/AuthHero"/>

<register-form action="#" method="post">
    <auth-input asp-for="Input.Email" />
    <auth-input asp-for="Input.Username" />
    <auth-input asp-for="Input.DateOfBirth" />
    <auth-input asp-for="Input.Password" />
    <auth-input asp-for="Input.ConfirmPassword" />

    <label
        for="terms"
        class="flex cursor-pointer items-start gap-3 rounded-lg
            border border-white/5 bg-white/[0.025] p-3.5
            transition hover:border-white/10 hover:bg-white/[0.04]"
    >
        <input
            type="checkbox"
            id="terms"
            name="terms"
            required
            class="mt-0.5 h-4 w-4 shrink-0 cursor-pointer
                rounded border-white/20 bg-white/10
                accent-[#603273] focus:ring-2 focus:ring-[#a875bc]"
        />

        <span class="text-xs leading-5 text-white/50">I agree to the 
            <a href="#" class="font-semibold text-[#c79bd5] hover:text-white">terms of service</a>
            and acknowledge the privacy policy.
        </span>
    </label> 
</register-form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
