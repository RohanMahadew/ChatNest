@page "/TestPage/{uuid?}"
@model PL.Pages.TestModel
@{
    ViewData["Title"] = "Overview & Messages";
}

<div class="relative z-20 col-span-full flex h-[calc(100vh-72px)] min-h-0 overflow-hidden selection:bg-[#603273] selection:text-white">
    <partial name="Components/ContactSidebar" />

    <section id="chatMainArea" class="relative flex h-full flex-1 flex-col overflow-hidden bg-[#070f2d]/50 backdrop-blur-md">
        <div id="activeChatView" class="@(Model.SelectedDirectMessage is null ? "hidden h-full w-full flex-col" : "flex h-full w-full flex-col")">
            <partial name="Components/ActiveChatHeader" />
            <div id="messagesContainer" class="flex-1 space-y-4 overflow-y-auto p-4 sm:p-6">
                <p class="py-12 text-center text-xs text-white/40">No messages yet.</p>
            </div>
            <div id="typingIndicator" class="hidden items-center gap-2 px-6 py-1.5 text-xs text-white/50">
                <span class="flex items-center gap-1 rounded-full border border-white/10 bg-white/[0.06] px-2.5 py-1"><span class="h-1.5 w-1.5 animate-bounce rounded-full bg-[#b98acb] [animation-delay:-0.3s]"></span><span class="h-1.5 w-1.5 animate-bounce rounded-full bg-[#b98acb] [animation-delay:-0.15s]"></span><span class="h-1.5 w-1.5 animate-bounce rounded-full bg-[#b98acb]"></span></span>
                <span id="typingAuthor" class="text-[11px] italic">Elena is typing...</span>
            </div>
            <partial name="Components/MessageComposer" />
        </div>
        <partial name="Components/EmptyChat" />
    </section>
</div>

<partial name="Components/AddContactModal" />
<partial name="Components/ToastNotification" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/chat-direct.js" asp-append-version="true"></script>
}
