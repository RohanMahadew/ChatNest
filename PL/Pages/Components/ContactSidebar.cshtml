@using BLL.Models.DTOs
@{
    var directMessages = ViewData["DirectMessages"] as IReadOnlyList<ChannelDTO> ?? [];
    var selectedDirectMessage = ViewData["SelectedDirectMessage"] as ChannelDTO;
}
<aside id="sidebarSection" class="flex h-full w-full shrink-0 flex-col border-r border-white/10 bg-[#091a50]/60 backdrop-blur-2xl transition-all duration-300 md:w-80 lg:w-96">
    <div class="space-y-3.5 border-b border-white/10 p-4">
        <div class="flex items-center justify-between">
            <h2 class="flex items-center gap-2 text-base font-bold tracking-tight text-white">Messages <span id="unreadCounterBadge" class="rounded-full border border-white/10 bg-[#603273]/60 px-2 py-0.5 text-[11px] font-bold text-[#c79bd5]">@directMessages.Count</span></h2>
            <button type="button" data-action="open-add-contact" class="group inline-flex items-center gap-1.5 rounded-lg bg-[#603273] px-3 py-1.5 text-xs font-semibold text-white shadow-md shadow-[#603273]/30 transition hover:bg-[#75418b] focus:outline-none focus:ring-2 focus:ring-[#a875bc]">
                <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" /></svg>
                <span>Add / New</span>
            </button>
        </div>
        <div class="relative">
            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-white/40">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
            </span>
            <input type="search" id="contactSearchInput" placeholder="Search direct messages..." class="h-10 w-full rounded-xl border border-white/10 bg-white/[0.06] pl-9 pr-8 text-xs text-white outline-none transition duration-200 placeholder:text-white/30 focus:border-[#a875bc] focus:bg-white/[0.09] focus:ring-2 focus:ring-[#603273]/40 sm:text-sm" />
            <button type="button" id="clearSearchBtn" class="absolute inset-y-0 right-0 hidden items-center pr-3 text-white/40 hover:text-white" aria-label="Clear search">
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
        </div>
        <div class="flex gap-1.5 rounded-lg border border-white/5 bg-white/[0.04] p-1" role="tablist" aria-label="Conversation types">
            <button type="button" data-filter="dm" role="tab" aria-selected="true" class="flex-1 rounded-md bg-[#603273] py-1 text-center text-xs font-semibold text-white shadow-sm transition">DM</button>
            <button type="button" data-filter="groups" role="tab" aria-selected="false" class="flex-1 rounded-md py-1 text-center text-xs font-medium text-white/60 transition hover:bg-white/[0.05] hover:text-white">Groups</button>
            <button type="button" data-filter="notifications" role="tab" aria-selected="false" class="flex-1 rounded-md py-1 text-center text-xs font-medium text-white/60 transition hover:bg-white/[0.05] hover:text-white">Notifications</button>
        </div>
    </div>
    <div id="contactListContainer" class="flex-1 space-y-1.5 overflow-y-auto px-2 py-3">
        @foreach (var chat in directMessages)
        {
            var displayName = chat.Name ?? "Unknown user";
            var isSelected = selectedDirectMessage?.Uuid == chat.Uuid;
            <a href="@Url.Page("/TestPage", new { uuid = chat.Uuid })" data-direct-chat data-username="@displayName" class="group flex w-full items-center gap-3 rounded-xl border p-3 text-left transition duration-150 hover:bg-white/[0.04] @(isSelected ? "border-[#a875bc]/40 bg-white/[0.09]" : "border-transparent hover:border-white/5")">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-gradient-to-tr from-[#603273] to-[#a875bc] text-xs font-bold text-white">@displayName.Substring(0, Math.Min(2, displayName.Length)).ToUpperInvariant()</span>
                <span class="min-w-0 flex-1">
                    <span class="block truncate text-xs font-semibold text-white sm:text-sm">@displayName</span>
                    <span class="block truncate text-[11px] text-white/50">Direct message</span>
                </span>
            </a>
        }
        @if (directMessages.Count == 0)
        {
            <p class="px-3 py-12 text-center text-xs text-white/40">No direct messages yet.</p>
        }
    </div>
    <div class="flex items-center justify-between border-t border-white/10 bg-white/[0.02] p-3 text-xs text-white/50">
        <div class="flex items-center gap-2"><span class="inline-block h-2 w-2 animate-pulse rounded-full bg-emerald-400"></span><span>Nest Connected</span></div>
        <span class="text-[11px] text-white/40">ChatNest v1.4</span>
    </div>
</aside>
