<template id="chatMessageTemplate">
    <div data-message-row class="flex flex-col items-start space-y-1">
        <div data-message-layout class="flex max-w-[85%] items-end gap-2 sm:max-w-[70%]">
            <span data-message-avatar class="mb-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-gradient-to-tr from-[#603273] to-[#a875bc] text-[10px] font-bold text-white"></span>
            <div data-message-bubble class="rounded-2xl border border-white/10 bg-white/[0.07] px-4 py-2.5 text-xs leading-relaxed text-white/95 shadow-md backdrop-blur-sm sm:text-sm">
                <p data-message-text></p>
            </div>
        </div>
        <span data-message-time class="px-1 text-[10px] text-white/35"></span>
    </div>
</template>
