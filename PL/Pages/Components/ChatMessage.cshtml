<template id="chatMessageTemplate">
    <div data-message-row class="group flex flex-col items-start space-y-1">
        <div data-message-layout class="flex max-w-[85%] items-end gap-2 sm:max-w-[70%]">
            <span data-message-avatar class="mb-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-gradient-to-tr from-[#603273] to-[#a875bc] text-[10px] font-bold text-white"></span>
            <div data-message-bubble class="min-w-0 rounded-2xl border border-white/10 bg-white/[0.07] px-4 py-2.5 text-xs leading-relaxed text-white/95 shadow-md backdrop-blur-sm sm:text-sm">
                <span data-message-sender class="mb-0.5 hidden text-[11px] font-semibold text-[#c79bd5]"></span>
                <p data-message-text class="whitespace-pre-wrap break-words"></p>
                <div data-message-edit-box class="hidden min-w-[220px] space-y-2 sm:min-w-[280px]">
                    <textarea data-message-edit-input rows="2" maxlength="4000" class="w-full resize-none rounded-xl border border-white/15 bg-[#070f2d]/70 px-3 py-2 text-xs text-white outline-none transition placeholder:text-white/30 focus:border-[#a875bc] focus:ring-2 focus:ring-[#603273]/40 sm:text-sm"></textarea>
                    <div class="flex items-center justify-end gap-1.5">
                        <button type="button" data-action="cancel-edit" class="rounded-lg border border-white/10 px-2.5 py-1 text-[11px] font-medium text-white/70 transition hover:bg-white/10 hover:text-white">Cancel</button>
                        <button type="button" data-action="save-edit" class="rounded-lg bg-[#603273] px-2.5 py-1 text-[11px] font-semibold text-white transition hover:bg-[#75418b] disabled:cursor-not-allowed disabled:opacity-50">Save</button>
                    </div>
                </div>
            </div>
            <div data-message-actions class="pointer-events-none hidden shrink-0 items-center gap-1 self-center opacity-0 transition-opacity duration-150 group-focus-within:pointer-events-auto group-focus-within:opacity-100 group-hover:pointer-events-auto group-hover:opacity-100">
                <div data-actions-default class="flex items-center gap-1">
                    <button type="button" data-action="edit-message" class="rounded-lg border border-white/10 bg-[#091a50]/90 px-2 py-1 text-[11px] font-medium text-white/75 shadow-sm transition hover:border-[#a875bc]/50 hover:bg-[#603273]/70 hover:text-white" aria-label="Modify message">Modify</button>
                    <button type="button" data-action="delete-message" class="rounded-lg border border-white/10 bg-[#091a50]/90 px-2 py-1 text-[11px] font-medium text-white/75 shadow-sm transition hover:border-rose-400/40 hover:bg-rose-500/25 hover:text-rose-200" aria-label="Delete message">Delete</button>
                </div>
                <div data-actions-confirm class="hidden items-center gap-1">
                    <button type="button" data-action="confirm-delete" class="rounded-lg border border-rose-400/40 bg-rose-500/30 px-2 py-1 text-[11px] font-semibold text-rose-100 shadow-sm transition hover:bg-rose-500/50 disabled:cursor-not-allowed disabled:opacity-50" aria-label="Confirm delete">Confirm</button>
                    <button type="button" data-action="cancel-delete" class="rounded-lg border border-white/10 bg-[#091a50]/90 px-2 py-1 text-[11px] font-medium text-white/70 shadow-sm transition hover:bg-white/10 hover:text-white" aria-label="Cancel delete">Cancel</button>
                </div>
            </div>
        </div>
        <div class="flex items-center gap-1.5 px-1 text-[10px] text-white/35">
            <span data-message-time></span>
            <span data-message-edited class="hidden italic text-white/40">(edited)</span>
        </div>
    </div>
</template>
