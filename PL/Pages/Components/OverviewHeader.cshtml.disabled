<header class="relative z-30 shrink-0 border-b border-white/10 bg-[#091a50]/75 backdrop-blur-xl">
    <nav class="flex h-16 w-full items-center justify-between px-4 sm:px-6 lg:px-8" aria-label="Main overview navigation">
        <div class="flex items-center gap-3">
            <a asp-page="/Index" class="group flex items-center gap-2.5 text-xl font-bold tracking-tight">
                <span class="flex h-9 w-9 items-center justify-center rounded-xl border border-white/15 bg-[#603273] text-sm font-extrabold shadow-lg shadow-purple-950/40 transition duration-300 group-hover:scale-105">C</span>
                <span class="text-lg font-black sm:text-xl">Chat<span class="text-[#b98acb]">Nest</span></span>
            </a>
            <span class="hidden rounded-full border border-white/10 bg-white/[0.06] px-2.5 py-0.5 text-[11px] font-medium tracking-wide text-white/60 sm:inline-block">Nest Hub</span>
        </div>
        <div class="flex items-center gap-2.5 sm:gap-4">
            <button type="button" id="toggleEmptyStateBtn" title="Toggle Empty / Active Chat State" class="hidden items-center gap-1.5 rounded-lg border border-white/10 bg-white/[0.05] px-3 py-1.5 text-xs font-medium text-white/75 transition hover:bg-white/10 hover:text-white sm:inline-flex">
                <svg class="h-3.5 w-3.5 text-[#b98acb]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
                <span id="toggleStateLabel">Show Empty State</span>
            </button>
            <button type="button" class="relative flex h-9 w-9 items-center justify-center rounded-xl border border-white/10 bg-white/[0.04] text-white/70 transition hover:bg-white/10 hover:text-white" aria-label="Notifications">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
                <span class="absolute right-2 top-2 h-2 w-2 rounded-full bg-[#b98acb] ring-2 ring-[#091a50]"></span>
            </button>
            <div class="flex cursor-pointer items-center gap-2.5 rounded-xl border border-white/10 bg-white/[0.05] p-1.5 pr-3 transition hover:bg-white/[0.08]">
                <div class="relative">
                    <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-gradient-to-tr from-[#603273] to-[#a875bc] text-xs font-bold shadow-sm">JD</div>
                    <span class="absolute -bottom-0.5 -right-0.5 h-2.5 w-2.5 rounded-full bg-emerald-400 ring-2 ring-[#091a50]"></span>
                </div>
                <div class="hidden text-left text-xs leading-none md:block">
                    <div class="font-semibold text-white">John Doe</div>
                    <div class="mt-0.5 text-[10px] text-white/50">Online</div>
                </div>
            </div>
        </div>
    </nav>
</header>
