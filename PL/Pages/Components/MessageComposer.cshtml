        <div class="relative flex-1">
            <!--Fix me at some point-->
            <textarea id="messageInput" rows="1" placeholder="Message..." class="max-h-32 min-h-11 w-full resize-none rounded-2xl border border-white/10 bg-white/[0.06] py-3 pl-4 pr-12 text-xs text-white outline-none transition placeholder:text-white/30 focus:border-[#a875bc] focus:bg-white/[0.09] focus:ring-2 focus:ring-[#603273]/30 sm:text-sm"></textarea>
