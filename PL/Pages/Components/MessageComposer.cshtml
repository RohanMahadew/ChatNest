<div class="border-t border-white/10 bg-[#091a50]/70 p-3 backdrop-blur-xl sm:p-4">
    <form id="messageForm" class="mx-auto flex max-w-5xl items-end gap-2 sm:gap-3">
        <div class="relative flex-1">
            <textarea id="messageInput" rows="1" maxlength="4000" placeholder="Message..." class="block max-h-32 min-h-11 w-full resize-none rounded-2xl border border-white/10 bg-white/[0.06] px-4 py-3 text-xs text-white outline-none transition placeholder:text-white/30 focus:border-[#a875bc] focus:bg-white/[0.09] focus:ring-2 focus:ring-[#603273]/30 sm:text-sm"></textarea>
        </div>
        <button type="submit" id="sendMessageButton" class="inline-flex h-11 shrink-0 items-center justify-center rounded-2xl bg-[#603273] px-5 text-xs font-semibold text-white shadow-md shadow-[#603273]/30 transition hover:bg-[#75418b] disabled:cursor-not-allowed disabled:opacity-50 sm:text-sm" aria-label="Send message">Send</button>
    </form>
    <p id="messageSendStatus" class="mx-auto hidden max-w-5xl px-2 pt-2 text-[11px] text-rose-300" aria-live="polite"></p>
</div>
