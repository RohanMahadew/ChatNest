<div id="createGroupModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4 backdrop-blur-sm" aria-hidden="true">
    <div class="relative w-full max-w-md rounded-2xl border border-white/10 bg-[#091a50]/95 p-6 shadow-2xl backdrop-blur-2xl" role="dialog" aria-modal="true" aria-labelledby="createGroupHeading">
        <button type="button" data-action="close-create-group" class="absolute right-4 top-4 flex h-8 w-8 items-center justify-center rounded-lg text-white/50 transition hover:bg-white/10 hover:text-white" aria-label="Close dialog"><svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg></button>
        <div class="mb-5">
            <span class="text-xs font-bold uppercase tracking-widest text-[#b98acb]">New Group</span>
            <h3 id="createGroupHeading" class="mt-1 text-xl font-bold tracking-tight text-white">Create a private group</h3>
            <p class="mt-1 text-xs text-white/50">Your group starts empty. You can invite people after creating it.</p>
        </div>
        <form method="post" asp-page="/TestPage" asp-page-handler="CreatePrivateGroup" class="space-y-4">
            <div>
                <label for="groupName" class="mb-1.5 block text-xs font-semibold text-white/80">Group name</label>
                <input type="text" id="groupName" name="groupName" maxlength="50" required autocomplete="off" class="h-10 w-full rounded-xl border border-white/10 bg-white/[0.07] px-3.5 text-sm text-white outline-none transition placeholder:text-white/25 focus:border-[#a875bc] focus:ring-2 focus:ring-[#603273]/40" />
            </div>
            <div class="flex gap-2.5">
                <button type="button" data-action="close-create-group" class="flex-1 rounded-xl border border-white/10 bg-white/[0.05] py-2.5 text-xs font-semibold text-white/70 transition hover:bg-white/10 hover:text-white">Cancel</button>
                <button type="submit" class="flex-1 rounded-xl bg-[#603273] py-2.5 text-xs font-semibold text-white transition hover:bg-[#75418b]">Create group</button>
            </div>
        </form>
    </div>
</div>
