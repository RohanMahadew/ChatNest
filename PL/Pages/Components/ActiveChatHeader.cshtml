@using BLL.Models.DTOs;
@{
    var selectedDirectMessage = ViewData["SelectedDirectMessage"] as ChannelDTO;
    var selectedName = selectedDirectMessage?.Name ?? string.Empty;
    var channelMembers = ViewData["ChannelMembers"] as IReadOnlyList<ChannelMemberDTO> ?? [];
    var currentUserId = ViewData["CurrentUserId"] as int? ?? 0;
}
<div class="relative z-30 flex h-16 shrink-0 items-center justify-between border-b border-white/10 bg-[#091a50]/65 px-4 backdrop-blur-xl sm:px-6">
    <div class="flex items-center gap-3">
        <button type="button" data-action="show-contacts" class="flex h-8 w-8 items-center justify-center rounded-lg border border-white/10 bg-white/[0.05] text-white/70 hover:text-white md:hidden" aria-label="Show contacts">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
        </button>
        <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/15 bg-gradient-to-tr from-[#603273] to-[#a875bc] text-sm font-bold text-white shadow-md">@(selectedName.Length == 0 ? string.Empty : selectedName.Substring(0, Math.Min(2, selectedName.Length)).ToUpperInvariant())</div>
        <div>
            <div class="flex items-center gap-2">
                <h3 id="activeChatName" class="text-sm font-bold tracking-tight text-white">@selectedDirectMessage?.Name</h3>
                <span class="hidden rounded-full border border-[#a875bc]/40 bg-[#603273]/30 px-2 py-0.5 text-[10px] text-[#c79bd5] sm:inline-block">Direct message</span>
            </div>
            <p class="text-xs font-medium text-white/50">Private conversation</p>
        </div>
    </div>
    <div class="relative flex items-center gap-1 sm:gap-2">
        @if (selectedDirectMessage is not null)
        {
            <button type="button" data-action="toggle-channel-menu" aria-expanded="false" aria-controls="channelContextMenu" class="flex h-9 w-9 items-center justify-center rounded-lg border border-white/10 bg-white/[0.05] text-white/80 transition hover:border-[#a875bc]/50 hover:bg-white/10 hover:text-white" aria-label="Open chat menu">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
            </button>
            <div id="channelContextMenu" class="absolute right-0 top-12 z-40 hidden w-80 rounded-2xl border border-white/15 bg-[#091a50]/95 p-4 shadow-2xl backdrop-blur-2xl">
                <div class="mb-3 flex items-center justify-between border-b border-white/10 pb-2.5">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-wider text-[#c79bd5]">Private Chat</p>
                        <p class="text-[11px] text-white/50">Users (@channelMembers.Count)</p>
                    </div>
                </div>
                <ul class="space-y-2">
                    @foreach (var member in channelMembers)
                    {
                        var isCurrentUser = member.UserId == currentUserId;
                        <li class="flex items-center justify-between gap-2 rounded-xl border border-white/5 bg-white/[0.03] px-3 py-2">
                            <div class="min-w-0">
                                <span class="block truncate text-xs font-semibold text-white">@@@member.UserName</span>
                                <span class="text-[10px] text-white/50">@(isCurrentUser ? "You" : "Participant")</span>
                            </div>
                            @if (!isCurrentUser)
                            {
                                <form method="post" asp-page="/TestPage" asp-page-handler="BlockDirectChat">
                                    <input type="hidden" name="uuid" value="@selectedDirectMessage.Uuid" />
                                    <button type="submit" class="rounded-lg border border-rose-400/30 bg-rose-500/15 px-2.5 py-1 text-[11px] font-semibold text-rose-200 transition hover:bg-rose-500/30">Block</button>
                                </form>
                            }
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</div>
