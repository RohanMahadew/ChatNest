@using BLL.Models.DTOs;
@{
    var selectedDirectMessage = ViewData["SelectedDirectMessage"] as ChannelDTO;
    var selectedName = selectedDirectMessage?.Name ?? string.Empty;
}
<div class="flex h-16 shrink-0 items-center justify-between border-b border-white/10 bg-[#091a50]/65 px-4 backdrop-blur-xl sm:px-6">
    <div class="flex items-center gap-3">
        <button type="button" data-action="show-contacts" class="flex h-8 w-8 items-center justify-center rounded-lg border border-white/10 bg-white/[0.05] text-white/70 hover:text-white md:hidden" aria-label="Show contacts">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
        </button>
        <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/15 bg-gradient-to-tr from-[#603273] to-[#a875bc] text-sm font-bold text-white shadow-md">@(selectedName.Length == 0 ? string.Empty : selectedName.Substring(0, Math.Min(2, selectedName.Length)).ToUpperInvariant())</div>
        <div>
            <div class="flex items-center gap-2">
                <h3 id="activeChatName" class="text-sm font-bold tracking-tight text-white">@selectedDirectMessage?.Name</h3>
                <span class="hidden rounded-full border border-[#a875bc]/40 bg-[#603273]/30 px-2 py-0.5 text-[10px] text-[#c79bd5] sm:inline-block">Direct message</span>
            </div>
            <p class="text-xs font-medium text-white/50">Private conversation</p>
        </div>
    </div>
    <div class="flex items-center gap-1 sm:gap-2">
        <!-- future buttons (i.e. block) -->
    </div>
</div>
