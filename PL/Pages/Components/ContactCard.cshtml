<template id="contactCardTemplate">
    <button type="button" data-contact-card class="group flex w-full items-center gap-3 rounded-xl border border-transparent p-3 text-left transition duration-150 hover:border-white/5 hover:bg-white/[0.04]">
        <span class="relative shrink-0">
            <span data-contact-avatar class="flex h-11 w-11 items-center justify-center rounded-xl border border-white/10 bg-gradient-to-tr from-[#603273] to-[#a875bc] text-xs font-bold text-white shadow-md transition duration-200 group-hover:scale-105"></span>
            <span data-contact-status class="absolute -bottom-0.5 -right-0.5 h-3 w-3 rounded-full ring-2 ring-[#091a50]"></span>
        </span>
        <span class="min-w-0 flex-1">
            <span class="mb-0.5 flex items-center justify-between">
                <span data-contact-name class="truncate text-xs font-semibold text-white sm:text-sm"></span>
                <span data-contact-time class="shrink-0 text-[10px] font-medium text-white/40"></span>
            </span>
            <span class="flex items-center justify-between text-xs text-white/50">
                <span class="truncate text-[11px] text-white/60 transition group-hover:text-white/80 sm:text-xs"><span data-preview-prefix class="text-[#b98acb]"></span><span data-contact-preview></span></span>
                <span data-unread-count class="ml-2 hidden h-4 min-w-[16px] items-center justify-center rounded-full border border-white/20 bg-[#603273] px-1 text-[10px] font-bold text-white shadow-sm"></span>
            </span>
        </span>
    </button>
</template>
