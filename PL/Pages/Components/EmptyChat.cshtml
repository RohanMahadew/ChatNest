@using BLL.Models.DTOs
@{
    var hasSelectedDirectMessage = ViewData["SelectedDirectMessage"] is ChannelDTO;
}
<div id="emptyChatView" class="@(hasSelectedDirectMessage ? "hidden h-full flex-1 flex-col items-center justify-center p-6 text-center sm:p-12" : "flex h-full flex-1 flex-col items-center justify-center p-6 text-center sm:p-12")">
    <div class="mx-auto max-w-md space-y-6">
        <div class="relative mx-auto h-24 w-24">
            <div class="absolute inset-0 animate-pulse rounded-2xl bg-[#603273]/40 blur-xl"></div>
            <div class="relative flex h-24 w-24 items-center justify-center rounded-2xl border border-white/15 bg-[#091a50]/80 shadow-2xl backdrop-blur-xl"><span class="flex h-12 w-12 items-center justify-center rounded-xl bg-[#603273] text-2xl font-black text-white shadow-inner">C</span></div>
        </div>
        <div class="space-y-2">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-white/[0.05] px-3 py-1 text-xs font-semibold tracking-wide text-[#c79bd5]"><span class="h-1.5 w-1.5 rounded-full bg-[#b98acb]"></span>YOUR NEST IS READY</span>
            <h2 class="text-2xl font-extrabold tracking-tight text-white sm:text-3xl">No chat selected</h2>
            <p class="mx-auto max-w-sm text-sm leading-relaxed text-white/50">Select a direct message from your sidebar or start a new conversation.</p>
        </div>
        <div class="flex flex-col items-center justify-center gap-3 pt-2 sm:flex-row">
            <button type="button" data-action="open-add-contact" class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-[#603273] px-5 py-2.5 text-xs font-bold text-white shadow-lg shadow-[#603273]/30 transition hover:bg-[#75418b] sm:w-auto">Start New Conversation</button>
        </div>
        <div class="grid grid-cols-2 gap-3 border-t border-white/10 pt-6 text-left">
            <div class="rounded-xl border border-white/5 bg-white/[0.02] p-3">
                <div class="text-xs font-semibold text-[#c79bd5]">We don't have features</div>
                <div class="mt-0.5 text-[11px] text-white/40">abcdef</div>
            </div>
            <div class="rounded-xl border border-white/5 bg-white/[0.02] p-3">
                <div class="text-xs font-semibold text-[#c79bd5]">Fast Realtime Sync</div>
                <div class="mt-0.5 text-[11px] text-white/40">Instant delivery across devices</div>
            </div>
        </div>
    </div>
</div>
